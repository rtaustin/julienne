---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import contact from '../data/contact.json';
import site from '../data/site.json';
---

<Base title="Contact" description="Get in touch with Julienne Blackburn about coaching, group sessions, or prayer.">
  <PageHero eyebrow={contact.eyebrow} heading={contact.heading} intro={contact.intro} />

  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          action="/thank-you"
          class="card p-7 sm:p-9"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Leave this field empty: <input name="bot-field" /></label>
          </p>

          <div class="field">
            <label class="field-label" for="name">Your name</label>
            <input class="field-input" type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="field">
            <label class="field-label" for="email">Email address</label>
            <input class="field-input" type="email" id="email" name="email" required autocomplete="email" />
          </div>

          <div class="field">
            <label class="field-label" for="topic">What is this about?</label>
            <select class="field-input" id="topic" name="topic">
              <option>One-on-one coaching</option>
              <option>Group sessions</option>
              <option>Prayer request</option>
              <option>Deliverance ministry</option>
              <option>Submitting art or a testimony</option>
              <option>Something else</option>
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="message">Your message</label>
            <span class="field-hint">
              Share as much or as little as you want. Nothing you write here is required.
            </span>
            <textarea class="field-input" id="message" name="message" required></textarea>
          </div>

          <label class="field-checkbox mb-6">
            <input type="checkbox" name="safe-to-reply" value="yes" />
            <span>It is safe to reply to this email address.</span>
          </label>

          <button type="submit" class="btn btn-primary w-full sm:w-auto">Send message</button>
        </form>
      </div>

      <aside class="space-y-6">
        <div class="rounded-2xl border-l-4 border-gold-500 bg-gold-100/60 p-7">
          <h2 class="font-heading text-base font-semibold text-navy-900">
            {contact.crisisHeading}
          </h2>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-navy-700">{contact.crisisBody}</p>
        </div>

        <div class="card p-7">
          <h2 class="font-heading text-base font-semibold text-navy-900">
            Other ways to reach me
          </h2>
          <ul class="mt-4 space-y-3 text-[0.95rem] text-navy-700">
            {site.email && (
              <li>
                <a href={`mailto:${site.email}`} class="text-green-700 underline underline-offset-4">
                  {site.email}
                </a>
              </li>
            )}
            {site.phone && <li>{site.phone}</li>}
            <li>
              <a href="/schedule" class="text-green-700 underline underline-offset-4">
                Book a session directly
              </a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>
