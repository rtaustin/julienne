---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import coaching from '../data/coaching.json';

const offerings = [
  { id: 'one-on-one', data: coaching.oneOnOne, tone: 'green' as const },
  { id: 'groups', data: coaching.groups, tone: 'gold' as const },
];
---

<Base
  title="Coaching"
  description="One-on-one trauma-informed coaching and small monthly group sessions for survivors of narcissistic and emotional abuse."
>
  <PageHero eyebrow={coaching.eyebrow} heading={coaching.heading} intro={coaching.intro} />

  <section class="container-page py-20 sm:py-24">
    <div class="grid gap-8 lg:grid-cols-2">
      {offerings.map(({ id, data, tone }) => (
        <article id={id} class="card flex scroll-mt-24 flex-col p-8 sm:p-10">
          <span
            class:list={[
              'inline-flex h-11 w-11 items-center justify-center rounded-full',
              tone === 'green' ? 'bg-green-100 text-green-700' : 'bg-gold-100 text-gold-700',
            ]}
          >
            <Icon name={tone === 'green' ? 'compass' : 'circle'} class="h-5 w-5" />
          </span>
          <h2 class="mt-5 font-display text-3xl text-navy-900">{data.title}</h2>
          <p class="mt-4 text-lg leading-relaxed text-navy-700">{data.summary}</p>

          <ul class="mt-7 space-y-3">
            {data.includes.map((item) => (
              <li class="flex gap-3 text-[0.97rem] leading-relaxed text-navy-700">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <p class="mt-7 rounded-xl bg-cream-warm p-5 text-sm leading-relaxed text-navy-700">
            <strong class="font-heading font-semibold text-navy-900">Who it is for: </strong>
            {data.goodFor}
          </p>

          <a href={data.ctaHref} class="btn btn-primary mt-8 self-start">
            {data.ctaLabel}
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-cream-warm py-20 sm:py-24">
    <div class="container-page">
      <div class="max-w-3xl">
      <h2 class="section-title">{coaching.faqHeading}</h2>
      <hr class="rule-gold mt-6" />
      <div class="mt-10 space-y-3">
        {coaching.faq.map((item, index) => (
          <details class="card group p-0" open={index === 0}>
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-heading text-base font-semibold text-navy-900"
            >
              {item.q}
              <span
                class="shrink-0 text-2xl leading-none text-gold-700 transition-transform group-open:rotate-45"
                aria-hidden="true">+</span
              >
            </summary>
            <p class="px-6 pb-6 leading-relaxed text-navy-700">{item.a}</p>
          </details>
        ))}
      </div>
      </div>
    </div>
  </section>
</Base>
