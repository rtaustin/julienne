---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BookingEmbed from '../components/BookingEmbed.astro';
import schedule from '../data/schedule.json';
---

<Base
  title="Schedule a Session"
  description="Book a one-on-one trauma-informed coaching session or request a seat in the monthly small group."
>
  <PageHero eyebrow={schedule.eyebrow} heading={schedule.heading} intro={schedule.intro} />

  <section class="container-page py-16 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display text-3xl text-navy-900">{schedule.oneOnOneHeading}</h2>
      <p class="mt-3 leading-relaxed text-navy-700">{schedule.oneOnOneNote}</p>
      <div class="mt-8">
        <BookingEmbed
          embedUrl={schedule.bookingEmbedUrl}
          fallbackUrl={schedule.bookingFallbackUrl}
          title="Book a one-on-one coaching session"
        />
      </div>
    </div>
  </section>

  <section id="groups" class="scroll-mt-24 bg-cream-warm py-16 sm:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <h2 class="font-display text-3xl text-navy-900">{schedule.groupHeading}</h2>
        <p class="mt-3 leading-relaxed text-navy-700">{schedule.groupNote}</p>
        <div class="mt-8">
          <BookingEmbed
            embedUrl={schedule.groupEmbedUrl}
            fallbackUrl={schedule.groupFallbackUrl}
            title="Request a seat in the monthly group session"
            height={700}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="section-title">{schedule.policiesHeading}</h2>
      <hr class="rule-gold mt-6" />
      <ul class="mt-8 space-y-4">
        {schedule.policies.map((policy) => (
          <li class="flex gap-3 leading-relaxed text-navy-700">
            <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" aria-hidden="true"></span>
            <span>{policy}</span>
          </li>
        ))}
      </ul>
      <p class="mt-10 rounded-xl bg-cream-warm p-6 text-sm leading-relaxed text-navy-700">
        Ready to pay for a session? <a href="/giving" class="text-green-700 underline underline-offset-4">See the payment options</a>.
      </p>
    </div>
  </section>
</Base>
