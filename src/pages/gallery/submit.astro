---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---

<Base
  title="Submit Your Work"
  description="Share the art, writing, or craft you made while working through abuse and trauma."
>
  <PageHero
    eyebrow="Share what you made"
    heading="Submit your work to the gallery"
    intro="A painting, a drawing, a poem, a quilt, a page from your journal, something you built with your hands — if it came out of the healing, it belongs here."
  />

  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <form
        name="gallery-submission"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        enctype="multipart/form-data"
        action="/thank-you"
        class="card p-7 sm:p-9"
      >
        <input type="hidden" name="form-name" value="gallery-submission" />
        <p class="hidden">
          <label>Leave this field empty: <input name="bot-field" /></label>
        </p>

        <div class="field">
          <label class="field-label" for="title">Title of the piece</label>
          <input class="field-input" type="text" id="title" name="title" required />
        </div>

        <div class="field">
          <label class="field-label" for="artist">How should it be credited?</label>
          <span class="field-hint">
            Your full name, a first name, initials, or "Anonymous" — completely your call.
          </span>
          <input class="field-input" type="text" id="artist" name="artist" placeholder="Anonymous" />
        </div>

        <div class="field">
          <label class="field-label" for="medium">What is it?</label>
          <span class="field-hint">e.g. acrylic on canvas, a poem, a journal collage, woodwork.</span>
          <input class="field-input" type="text" id="medium" name="medium" />
        </div>

        <div class="field">
          <label class="field-label" for="artwork">Upload a photo of your piece</label>
          <span class="field-hint">JPG, PNG, or PDF. A phone photo in good light is perfect.</span>
          <input class="field-input" type="file" id="artwork" name="artwork" accept="image/*,.pdf" required />
        </div>

        <div class="field">
          <label class="field-label" for="story">The story behind it</label>
          <span class="field-hint">
            As much or as little as you want to say. This gets published with the piece unless you
            ask otherwise.
          </span>
          <textarea class="field-input" id="story" name="story"></textarea>
        </div>

        <div class="field">
          <label class="field-label" for="email">Your email</label>
          <span class="field-hint">Only so Julienne can reach you. It is never published.</span>
          <input class="field-input" type="email" id="email" name="email" required autocomplete="email" />
        </div>

        <label class="field-checkbox mb-4">
          <input type="checkbox" name="permission" value="yes" required />
          <span>
            I made this piece, and I give permission for it to be shown on this website with the
            credit I chose above.
          </span>
        </label>

        <label class="field-checkbox mb-6">
          <input type="checkbox" name="prayer" value="yes" />
          <span>Please pray over this piece and over me.</span>
        </label>

        <button type="submit" class="btn btn-primary w-full sm:w-auto">Send my submission</button>
      </form>

      <aside class="space-y-6">
        <div class="card p-7">
          <h2 class="font-heading text-base font-semibold text-navy-900">
            What happens after you send it
          </h2>
          <ol class="mt-4 space-y-3 text-[0.95rem] leading-relaxed text-navy-700">
            <li><strong>1.</strong> Julienne receives it directly. No one else sees it.</li>
            <li><strong>2.</strong> She reviews it and prays over it personally.</li>
            <li><strong>3.</strong> If it is a fit for the gallery, she posts it with the credit you chose.</li>
            <li><strong>4.</strong> If it is not, she will tell you kindly and directly — and nothing is posted.</li>
          </ol>
        </div>

        <div class="rounded-2xl border-l-4 border-gold-500 bg-gold-100/60 p-7">
          <h2 class="font-heading text-base font-semibold text-navy-900">
            A note on what is posted
          </h2>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-navy-700">
            This gallery is a place of healing and light. Nothing is posted without being reviewed
            and prayed over first, and Julienne reserves the right to decline anything that does not
            belong in that space. Your work is never posted automatically.
          </p>
        </div>

        <div class="rounded-2xl bg-cream-warm p-7">
          <p class="text-[0.95rem] leading-relaxed text-navy-700">
            Please do not include other people's names, faces, or identifying details in what you
            send. Your safety, and theirs, comes first.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>
