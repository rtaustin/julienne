---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import giving from '../data/giving.json';
import site from '../data/site.json';

const methods = giving.methods.filter((method) => method.enabled);
---

<Base
  title="Payment"
  description="Pay for a coaching session by Zelle, PayPal, or Venmo."
>
  <PageHero eyebrow={giving.eyebrow} heading={giving.heading} intro={giving.intro} />

  <section class="container-page py-16 sm:py-20">
    {methods.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-3">
        {methods.map((method) => (
          <article class="card flex flex-col p-7">
            <h2 class="font-heading text-lg font-semibold text-navy-900">
              {method.name}
            </h2>
            {method.handle && (
              <p class="mt-3 font-heading text-base break-words text-green-700">
                {method.handle}
              </p>
            )}
            {method.note && (
              <p class="mt-3 grow text-[0.95rem] leading-relaxed text-navy-700">{method.note}</p>
            )}
            {method.url && (
              <a href={method.url} target="_blank" rel="noopener" class="btn btn-primary mt-6 self-start">
                Open {method.name}
                <Icon name="arrow" class="h-4 w-4" />
              </a>
            )}
          </article>
        ))}
      </div>
    ) : (
      <div class="mx-auto max-w-2xl rounded-2xl border border-dashed border-gold-500/60 bg-gold-100/50 p-8 text-center">
        <p class="font-heading text-base font-semibold text-navy-900">
          Payment details are being set up.
        </p>
        <p class="mx-auto mt-3 max-w-md leading-relaxed text-navy-700">
          Get in touch and Julienne will send you everything you need to pay for your session.
        </p>
        <a href="/contact" class="btn btn-primary mt-6">Contact Julienne</a>
      </div>
    )}

    <p class="mx-auto mt-12 max-w-2xl rounded-xl bg-cream-warm p-6 text-center leading-relaxed text-navy-700">
      {giving.footnote}
    </p>
  </section>

  <section class="bg-cream-warm py-16 sm:py-20">
    <div class="container-prose text-center">
      <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white text-gold-700">
        <Icon name="heart" class="h-5 w-5" />
      </span>
      <h2 class="section-title mt-5">{giving.supportHeading}</h2>
      <p class="mt-5 leading-relaxed text-navy-700">{giving.supportBody}</p>
      {site.email && (
        <p class="mt-6 text-sm text-navy-600">
          Questions about payment?
          <a href={`mailto:${site.email}`} class="text-green-700 underline underline-offset-4">{site.email}</a>
        </p>
      )}
    </div>
  </section>
</Base>
