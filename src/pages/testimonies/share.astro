---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---

<Base
  title="Share Your Story"
  description="Tell your story of working through abuse, so the next person can believe healing is possible."
>
  <PageHero
    eyebrow="Your story matters"
    heading="Share your testimony"
    intro="Someone is where you used to be, and they do not believe it gets better yet. Your story might be the thing that changes that."
  />

  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <form
        name="testimony"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        action="/thank-you"
        class="card p-7 sm:p-9"
      >
        <input type="hidden" name="form-name" value="testimony" />
        <p class="hidden">
          <label>Leave this field empty: <input name="bot-field" /></label>
        </p>

        <div class="field">
          <label class="field-label" for="display-name">How should your story be credited?</label>
          <span class="field-hint">
            Your first name, initials, or "Anonymous". Many people choose Anonymous, and that is
            completely fine.
          </span>
          <input class="field-input" type="text" id="display-name" name="display-name" placeholder="Anonymous" />
        </div>

        <div class="field">
          <label class="field-label" for="headline">If you had one line to say to someone still in it</label>
          <input class="field-input" type="text" id="headline" name="headline" required />
        </div>

        <div class="field">
          <label class="field-label" for="story">Your story</label>
          <span class="field-hint">
            Take as much room as you need. Please leave out other people's names and identifying
            details — for your safety as much as anything.
          </span>
          <textarea class="field-input" id="story" name="story" required rows="12"></textarea>
        </div>

        <div class="field">
          <label class="field-label" for="email">Your email</label>
          <span class="field-hint">Only so Julienne can reach you. It is never published.</span>
          <input class="field-input" type="email" id="email" name="email" required autocomplete="email" />
        </div>

        <label class="field-checkbox mb-6">
          <input type="checkbox" name="permission" value="yes" required />
          <span>
            I give permission for my story to be published on this website with the credit I chose
            above, and I understand it may be lightly edited for length or clarity.
          </span>
        </label>

        <button type="submit" class="btn btn-primary w-full sm:w-auto">Send my story</button>
      </form>

      <aside class="space-y-6">
        <div class="rounded-2xl border-l-4 border-green-700 bg-green-100/70 p-7">
          <h2 class="font-heading text-base font-semibold text-navy-900">
            Nothing is published without you
          </h2>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-navy-700">
            Julienne reads every story herself and will always check with you before anything goes
            up. If you change your mind at any point — before or after — say the word and it comes
            down.
          </p>
        </div>

        <div class="card p-7">
          <h2 class="font-heading text-base font-semibold text-navy-900">
            Before you write
          </h2>
          <ul class="mt-4 space-y-3 text-[0.95rem] leading-relaxed text-navy-700">
            <li>Write it when you are steady, not in the middle of a hard night.</li>
            <li>Leave out names, places, and details that could identify anyone.</li>
            <li>You do not owe anyone the worst parts. Share only what you want to share.</li>
            <li>It is fine to stop halfway and come back another day.</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>
