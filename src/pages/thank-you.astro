---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Thank you" noindex={true}>
  <section class="container-prose py-24 text-center sm:py-32">
    <span class="mx-auto inline-flex h-14 w-14 items-center justify-center rounded-full bg-green-100 text-green-700">
      <Icon name="heart" class="h-6 w-6" />
    </span>
    <h1 class="section-title mt-6">Thank you — it came through.</h1>
    <hr class="rule-gold mx-auto mt-6" />
    <p class="mt-6 text-lg leading-relaxed text-navy-700">
      Julienne reads every message herself, and she will get back to you personally. That usually
      takes a day or two.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to the home page</a>
      <a href="/prayers" class="btn btn-outline">Read a prayer while you wait</a>
    </div>
  </section>
</Base>
