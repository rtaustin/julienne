---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../lib/format';
import site from '../../data/site.json';

export const getStaticPaths: GetStaticPaths = async () => {
  const prayers = await getCollection('prayers', ({ data }) => !data.draft);
  return prayers.map((prayer) => ({
    params: { slug: prayer.id },
    props: { prayer },
  }));
};

const { prayer } = Astro.props;
const { Content } = await render(prayer);
const siteHost = (Astro.site ?? new URL(Astro.url.origin)).host;
---

<Base title={prayer.data.title} description={prayer.data.summary ?? `A free printable prayer from ${site.name}.`}>
  <article class="container-prose print-page py-14 sm:py-20">
    <a
      href="/prayers"
      class="no-print inline-flex items-center gap-2 font-heading text-sm font-semibold text-green-700 underline-offset-4 hover:underline"
    >
      <span aria-hidden="true">&larr;</span>
      All prayers
    </a>

    <header class="mt-8">
      <p class="font-heading text-[0.68rem] font-semibold tracking-[0.16em] text-gold-700 uppercase">
        {prayer.data.category}
      </p>
      <h1 class="mt-3 font-display text-[clamp(2rem,1.4rem+2.2vw,3rem)] leading-tight font-medium text-navy-900">
        {prayer.data.title}
      </h1>
      {prayer.data.scripture && (
        <p class="mt-3 font-display text-lg text-green-700 italic">
          {prayer.data.scripture}
        </p>
      )}
      <hr class="rule-gold mt-6" />
    </header>

    <div class="prose prose-brand prose-lg mt-10 max-w-none">
      <Content />
    </div>

    <div class="no-print mt-12 flex flex-wrap items-center gap-3 border-t border-navy-800/10 pt-8">
      <button type="button" id="print-prayer" class="btn btn-primary">
        <Icon name="print" class="h-4 w-4" />
        Print this prayer
      </button>
      <a href="/prayers" class="btn btn-outline">Read another</a>
    </div>

    <p class="no-print mt-6 text-sm text-navy-600">
      Published {formatDate(prayer.data.date)}. Free to print and share.
    </p>

    <p class="mt-10 hidden text-center text-xs text-navy-600 print:block">
      {site.name} &middot; {siteHost}
    </p>
  </article>
</Base>

<script>
  document.getElementById('print-prayer')?.addEventListener('click', () => window.print());
</script>
