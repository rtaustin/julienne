---
interface Props {
  name: 'compass' | 'circle' | 'leaf' | 'arrow' | 'print' | 'menu' | 'close' | 'play' | 'sun' | 'heart';
  class?: string;
}
const { name, class: className = 'h-5 w-5' } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'compass' && (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="m15.5 8.5-2.1 5-5 2.1 2.1-5z"></path>
    </>
  )}
  {name === 'circle' && (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <circle cx="12" cy="12" r="3.5"></circle>
    </>
  )}
  {name === 'leaf' && (
    <>
      <path d="M4 20c0-8 5-13 15-13 0 8-5 13-15 13z"></path>
      <path d="M9 15c1.8-2.7 4-4.6 7-5.7"></path>
    </>
  )}
  {name === 'arrow' && <path d="M5 12h13m-5-6 6 6-6 6"></path>}
  {name === 'print' && (
    <>
      <path d="M7 9V4h10v5"></path>
      <path d="M7 18H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"></path>
      <rect x="7" y="14" width="10" height="7" rx="1"></rect>
    </>
  )}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16"></path>}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18"></path>}
  {name === 'play' && (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M10 8.5v7l6-3.5z"></path>
    </>
  )}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </>
  )}
  {name === 'heart' && (
    <path d="M12 20s-7-4.4-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.6-7 9-7 9z"></path>
  )}
</svg>
